{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "msvc",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/out/build/msvc"
    },
    {
      "name": "msvc-ninja",
      "displayName": "MSVC via Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/msvc-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "web-debug",
      "displayName": "web-debug",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/out/build/web-debug",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/out/build/web-debug-renderer"
      },
      "environment": {
        "EM_CACHE": "${sourceDir}/out/emscripten-cache"
      }
    },
    {
      "name": "web-release",
      "displayName": "web-release",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/out/build/web-release",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/out/build/web-release-renderer"
      },
      "environment": {
        "EM_CACHE": "${sourceDir}/out/emscripten-cache"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-debug",
      "displayName": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug"
    },
    {
      "name": "msvc-release",
      "displayName": "msvc-release",
      "configurePreset": "msvc",
      "configuration": "Release"
    },
    {
      "name": "msvc-ninja-debug",
      "displayName": "MSVC Ninja Debug",
      "configurePreset": "msvc-ninja"
    },
    {
      "name": "web-debug",
      "displayName": "web-debug",
      "configurePreset": "web-debug",
      "environment": {
        "EM_CACHE": "${sourceDir}/out/emscripten-cache"
      }
    },
    {
      "name": "web-release",
      "displayName": "web-release",
      "configurePreset": "web-release",
      "environment": {
        "EM_CACHE": "${sourceDir}/out/emscripten-cache"
      }
    }
  ]
}

